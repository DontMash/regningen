{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "de",
  "locales": ["de", "en"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4.5.4/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}/common.json",
      "./messages/{locale}/meta.json",
      "./messages/{locale}/artwork.json",
      "./messages/{locale}/settings.json",
      "./messages/{locale}/shell.json",
      "./messages/{locale}/landing.json",
      "./messages/{locale}/profile.json",
      "./messages/{locale}/invoice.json",
      "./messages/{locale}/pdf.json",
      "./messages/{locale}/pwa.json",
      "./messages/{locale}/release.json"
    ]
  }
}
