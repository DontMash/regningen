# Optional canonical origin; empty keeps this deployment noindex with no public identity.
# Examples: http://localhost:3000 or https://example.com (replace for deployment).
ORIGIN=

# Exactly true or false. Enable only behind a trusted, sanitizing proxy with a protected backend.
TRUST_PROXY=false

# off | one-day | one-week | one-year | reset; verify public HTTPS before rollout.
HSTS_STAGE=off
